# Aplicação (webhook + CrewAI) — copie para .env e preencha os valores.

# WhatsApp: grupo escutado e JID do bot (para detecção de menção)
TARGET_GROUP_ID=
TARGET_MENTIONED_JID=

# LLM de produção (Configure com o modelo e provedor da sua escolha compatível com o formato da API Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Banco de dados pluviométricos (PostgreSQL/Supabase)
SUPABASEDB_URI=

# Evolution API (gateway WhatsApp)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
